<root main_tree_to_execute="Navigate">
  <BehaviorTree ID="Navigate">
    <RecoveryNode number_of_retries="12" name="BoundedStandOnRecovery">
      <Sequence>
        <NavigationContract operation="begin"/>
        <PipelineSequence>
          <RateController hz="0.333">
            <Sequence>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}"
                radius="{usv_via_radius}" global_frame="{usv_global_frame}" robot_base_frame="{usv_robot_frame}"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </Sequence>
          </RateController>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </PipelineSequence>
      </Sequence>
      <Sequence>
        <NavigationContract operation="stop"/>
        <NavigationContract operation="quiet"/>
        <NavigationContract operation="retry"/>
        <Wait wait_duration="5"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>

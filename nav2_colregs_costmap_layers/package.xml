<?xml version="1.0"?>
<package format="3">
  <name>nav2_colregs_costmap_layers</name>
  <version>1.0.0</version>
  <description>Custom Nav2 costmap layer plugins for COLREGS (TS projection).</description>
  <maintainer email="vectorwang@hotmail.com">Vector Wang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_costmap_2d</depend>
  <depend>nav2_colregs_msgs</depend>
  <depend>usv_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>nav2_planner</test_depend>
  <test_depend>nav2_navfn_planner</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <costmap_2d plugin="${prefix}/plugins.xml" />
  </export>
</package>

<?xml version="1.0"?>
<package format="3">
  <name>nav2_colregs_alos_controller</name>
  <version>1.0.0</version>
  <description>Adaptive Line-of-Sight (ALOS) guidance controller with sideslip compensation.</description>
  <maintainer email="vectorwang@hotmail.com">Vector Wang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/alos_controller_plugin.xml" />
  </export>
</package>

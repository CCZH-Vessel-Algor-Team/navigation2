<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_colregs_bringup</name>
  <version>0.1.0</version>
  <description>COLREGS-compliant local planner bringup package for development and testing</description>
  <maintainer email="vectorwang@hotmail.com">vectorwang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_minimal_tb3_sim</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>nav2_colregs_msgs</exec_depend>
  <exec_depend>nav2_colregs_local_planner_server</exec_depend>
  <exec_depend>nav2_colregs_local_path_bt_nodes</exec_depend>
  <exec_depend>nav2_colregs_vector_object_server</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_skeleton_planner</name>
  <version>0.1.0</version>
  <description>
    Plain (non-COLREGS) Nav2 global planner plugin wrapping the persistent
    goal-rooted skeleton RRT* core. The core search machinery lives in
    nav2_colregs_vo_skeleton_planner; this package provides the standalone
    entry point without the VO service chain.
  </description>
  <maintainer email="vectorwang@hotmail.com">vectorwang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav2_colregs_vo_skeleton_planner</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/nav2_skeleton_planner.xml"/>
  </export>
</package>
